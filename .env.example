OPENROUTER_API_KEY=
PORT=3001
HOST=127.0.0.1
# Optional custom location for history, uploads and collections.
DATA_DIR=data
# true: isolated demo, no OpenRouter calls or charges
DEMO_MODE=false
# Optional stable HTTPS origin serving ONLY /media/* through a tunnel/reverse proxy.
PUBLIC_ASSET_BASE_URL=
# Optional: create a temporary trycloudflare.com URL for local MP4 files.
# The public host exposes only opaque /media/<uuid> file URLs; Studio/API stay local.
AUTO_PUBLIC_MEDIA_TUNNEL=false
# Optional stable fallback when Cloudflare Tunnel is blocked by VPN.
MEDIA_WORKER_URL=
MEDIA_WORKER_TOKEN=
# Optional local HTTP proxy. Leave blank for direct access.
OPENROUTER_PROXY_URL=
# Optional local VPN/proxy application to start with the Windows launcher.
VPN_APP_PATH=
